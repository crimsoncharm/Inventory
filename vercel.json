{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/proxy",
      "destination": "/api/proxy.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/",
      "destination": "/Index.html"
    },
    {
      "source": "/index.html",
      "destination": "/Index.html"
    }
  ]
}
